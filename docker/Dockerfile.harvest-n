FROM mars-dssat:sequence-native
USER 0
COPY docker/patch_harvest_n_inventory.py /build/metadata/patch_harvest_n_inventory.py
RUN python3 /build/metadata/patch_harvest_n_inventory.py /build/source && cmake --build /build/control -j4 && cp /build/control/bin/dscsm048 /opt/dssat_pdi/mars_harvest_n_candidate_dscsm048
USER gymusr
