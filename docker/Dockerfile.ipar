FROM mars-dssat:metadata-audit
USER 0
COPY docker/patch_ipar_source.py /build/metadata/patch_ipar_source.py
RUN python3 /build/metadata/patch_ipar_source.py /build/source && cmake --build /build/control -j4 && cp /build/control/bin/dscsm048 /opt/dssat_pdi/mars_ipar_dscsm048 && printf '#!/bin/sh\nexec /opt/dssat_pdi/mars_ipar_dscsm048 "$@"\n' > /opt/mars/run_ipar && chmod +x /opt/mars/run_ipar
USER gymusr
